# Hermes Deck relay settings. Copy to .env (the macOS installer does this and generates the token).

# Address to listen on. Use a private address only: your Tailscale/WireGuard IP or 127.0.0.1.
# Never 0.0.0.0 on a machine reachable from the internet.
DECK_RELAY_HOST=127.0.0.1
DECK_RELAY_PORT=9330
# 64 hex chars; generate with: openssl rand -hex 32
DECK_RELAY_TOKEN=
# Clients send the token in the Authorization header. 1 also accepts it as ?token= on the WebSocket, for a
# client that cannot set headers; a token in a URL can end up in a proxy's access log, so leave it off.
DECK_RELAY_QUERY_TOKEN=0

# Optional: watch Claude Code transcripts too (comma-separated ~/.claude/projects/<dir> paths).
CLAUDE_PROJECT_DIRS=
# Profile name those sessions get (map it to a display name and bot in agents.json).
CLAUDE_PROFILE=claude-code
# Optional: a bot bridge's state file mapping chats to Claude sessions:
# {"chats": {"<chatId>[:<threadId>]": {"session": "<claude session id>"}}}
CLAUDE_CHAT_MAP=

# Message history for the deck's session/sub-agent view, read on demand and read-only: Hermes' root
# folder (state.db + profiles/<name>/state.db; empty = ~/.hermes) and the Claude transcripts above.
# Hermes history needs Node 22.13+ (node:sqlite). DECK_HISTORY=0 turns the history routes off.
HERMES_ROOT=
DECK_HISTORY=1

# macOS only: launchd labels starting with these prefixes appear in the Fleet tab (comma-separated).
DECK_LAUNCHD_PREFIXES=ai.hermes.
# Path to the CodexBar CLI for Claude/Codex usage windows; leave empty to disable.
CODEXBAR=/opt/homebrew/bin/codexbar

# Workspace tab (agent browsers). Hermes on THIS machine reaches an agent's browser over CDP at
#   http://127.0.0.1:<DECK_CDP_PORT>/agent/<profile>     (browser.cdp_url in that profile's config)
# By default the browser runs on THIS machine (the agent host): you watch it from the Deck's Workspace tab and
# can take control; the agent is the controller until you do. A Deck PC hosts it only when you pick "This
# computer" there (and its owner switched "Agent browser allowed on this device" on in Settings > This device).
# Loopback only, never exposed to the network; 0 turns the endpoint off.
DECK_CDP_PORT=9333
# Agent whose browser the bare root URL (no /agent/<profile>) belongs to.
DECK_CDP_DEFAULT_AGENT=default
# Where "Automatic" puts an agent's browser: host (default) = the agent host's browser (the two settings below)
# first, a Deck PC only when the agent host has none for that agent; device = the earlier order: the Deck PC
# you used last first, the agent host as the fallback. The user's own pick in the Workspace tab always wins.
DECK_BROWSER_DEFAULT=host
# Agent host browser, kind 1: ONE already running browser (e.g. a persistent headful Chrome kept alive by its own
# service, with logged-in sites) attached over its loopback debugging port. The relay only attaches and detaches:
# it never launches, restarts or closes it (Browser.close/Browser.crash from the agent are refused), and it picks
# the browser up again after it restarts. It is shared by ONE agent profile (below); other agents get no browser
# on the agent host unless DECK_FALLBACK_BROWSER=1 as well. Loopback http URL only. Empty = off.
# Then point that profile's Hermes browser.cdp_url at http://127.0.0.1:<DECK_CDP_PORT>/agent/<profile>.
DECK_FALLBACK_BROWSER_CDP=
# The agent profile that owns the external browser (default: DECK_CDP_DEFAULT_AGENT).
DECK_FALLBACK_BROWSER_CDP_AGENT=
# Agent host browser, kind 2: a headless Chrome per agent, its own profile under data/agent-browsers (never your
# own Chrome or its debugging port). The deck watches it live over its relay connection.
# 0 = off (the default).
DECK_FALLBACK_BROWSER=0
# Optional: Chrome, Chromium or Edge binary for it (found automatically otherwise).
DECK_FALLBACK_BROWSER_PATH=
# Optional: this machine's name in the Workspace host picker (default: macOS computer name, else host name).
DECK_HOST_NAME=
# Hermes side: give each profile that browses through the Deck its own browser-harness home in that
# profile's .env, BH_HOME=~/.hermes/profiles/<profile>/browser-harness. browser-harness otherwise shares
# one daemon per name among all profiles of the user, and the first profile to browse captures the rest.

# Bot screen (computer_use on your own computers; docs/bot-screen-protocol.md). Off until a Hermes profile
# sets HERMES_CUA_DRIVER_CMD to relay/bin/deck-cua and a deck with a device token turns
# "Desktop control" on (tokens: node tools/device-token.js add <name>).
# 1 = when no device may host, run computer_use on this agent host instead. 0 = off (the default): then
# the agent gets a "no device" answer.
DECK_DESKTOP_HOST=0
# Agent spaces (docs/agent-spaces.md): agents work on their own desktop.
# shared = this machine's desktop, one agent at a time (others wait up to 120 s); agent = one desktop each
# (phase 2, docs/agent-spaces.md: each agent's own Linux desktop in a
# container on a desktop host; the shared desktop is the fallback). overflow = shared first, own desktop when
# busy; configure desktop hosts as for agent mode. Empty = off. The shared desktop needs
# cua-spacesd on loopback (relay/tools/install-spacesd.sh).
DECK_SPACES=
# Overflow sessions keep their desktop until this many seconds without a call (30-900, default 120).
DECK_SPACES_STICKY_SEC=120
DECK_SPACESD_URL=http://127.0.0.1:3211
DECK_SPACESD_TOKEN_FILE=~/.cua-spacesd/token
# Phase 2 (DECK_SPACES=agent or overflow). A Deck computer becomes a desktop host from Settings (off by default).
# 1 = this machine (the agent host) also hosts agent desktops, through Docker or colima; the pinned images must be
# pulled first (the relay never pulls them). 0 = off (the default). Switching it back to 0 leaves agent desktop
# containers that still run here untouched; stop them with
#   docker ps -q --filter label=hermes-deck.space=1 | xargs docker stop
DECK_DESKTOPS_HOST=0
# How many agent desktops may run here at once. Empty = 1, or 0 (with a warning) on a machine with less than 16 GB RAM.
DECK_DESKTOPS_LIMIT=
# Minutes without an agent action, a viewer or user control before an agent desktop on this machine stops (5-240).
# A Deck host uses its own setting.
DECK_DESKTOPS_IDLE_MIN=20
# Which agents may have a desktop of their own, on any desktop host (Hermes profiles, comma-separated, e.g.
# researcher,writer). Empty = every configured agent. An agent not on the list never gets a container: it works on the
# shared desktop (DECK_SPACES_SHARED_FALLBACK=1) or gets a tool error, and the Deck's Start button refuses it.
DECK_DESKTOPS_AGENTS=
# 1 = an agent whose own desktop is unavailable works on the shared desktop (taking turns); 0 = it gets a tool
# error saying why.
DECK_SPACES_SHARED_FALLBACK=1
# Hermes' own Python, for Take control / Return control (the Bot Desktop lease). Empty = the standard
# ~/.hermes/hermes-agent/venv/bin/python when it exists.
DECK_HERMES_PYTHON=
# The real cua-driver deck-cua runs for the agent-host route. Empty = cua-driver on PATH.
DECK_CUA_DRIVER=

# iOS separate hashed mobile tokens. Five-minute single-use pairing code on the server:
# node tools/mobile-token.js pair ; list ; revoke <deviceId>
DECK_MOBILE_DEVICES_FILE=
# Existing Hermes stream.py --follow with Hermes' interpreter. Empty stream disables bridge.
DECK_MOBILE_BRIDGE_PYTHON=python3
DECK_MOBILE_BRIDGE_STREAM=
# Metadata-only central push gateway. APNs keys live on gateway.
HERMES_PUSH_URL=
HERMES_PUSH_SENDER_TOKEN=

# Updates (bin/deck-relay-update, docs/updating.md). Repository to update from (owner/name); empty = the
# "repository" in package.json. 1 = the daily update check also installs the update (default: off).
DECK_UPDATE_REPO=
DECK_RELAY_AUTO_UPDATE=0
# The service apply restarts: systemd --user unit (default hermes-deck-relay) or launchd label on macOS
# (default com.hermes-deck.relay).
DECK_RELAY_SERVICE=

# Settings > Hermes config (docs/relay.md): edit each profile's config.yaml from the Deck and restart the Hermes
# gateway or this relay. Desktop relay token only, never a mobile token. 0 turns it off.
DECK_HERMES_CONFIG=1
# Hermes' Python (runs tools/hermes-config.py); empty: DECK_MOBILE_BRIDGE_PYTHON, else ~/.hermes/hermes-agent/venv.
DECK_HERMES_PYTHON=
# Hermes' install directory when it is not the folder around that Python's venv.
HERMES_AGENT_DIR=
# The hermes command for "Restart gateway" (default: hermes on PATH).
DECK_HERMES_BIN=

# Agent spaces: activity and safety (shared relay settings).
# DECK_AUDIT=0 forces the audit off even when a Deck setting requests it.
DECK_AUDIT=1
# Initial defaults; persisted Deck settings take precedence for days/keep.
# Days: 1-90 (finite numeric environment values are truncated and clamped).
DECK_AUDIT_DAYS=7
# Undo points: integer 1-100; invalid environment values use the default 10.
# Archives also have a 5 GB per-agent ceiling; homes above 2 GB are skipped.
DECK_SNAPSHOT_KEEP=10
# Optional administrator regex file, one case-insensitive expression per line.
# Empty means built-in patterns only; blank lines and # comments are ignored.
# Invalid/unsafe expressions are skipped with a warning; an unreadable file fails startup.
DECK_RISKY_PATTERNS_FILE=

# Paths (empty = the default shown). DECK_EVENTS_DIR and DECK_STATE_DIR do not follow DECK_HOME; keep all four
# equal to what the Hermes plugin uses (docs/relay.md, Environment options).
# DECK_DATA_DIR=relay/data          relay state
# DECK_AGENTS=relay/agents.json     agent mapping
# DECK_DEVICE_TOKENS=devices.json   device-key hashes, next to this .env
# DECK_HOME=~/.hermes-deck          the plugin's home; the driver socket default lives here
# DECK_EVENTS_DIR=~/.hermes-deck/events
# DECK_STATE_DIR=~/.hermes-deck/state
# DECK_DRIVER_SOCK=<DECK_HOME>/driver.sock
