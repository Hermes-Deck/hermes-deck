# dependencies and build output
node_modules/
dist/
out/
__pycache__/
*.pyc

# generated at install time (npm postinstall copies fonts out of @fontsource)
app/renderer/fonts/
app/renderer/fonts*.css

# per-install secrets and state: never commit
.env
.env.*
!.env.example
*.session
*.session.*
relay/agents.json
relay/devices.json
relay/data/
relay/logs/

# screenshots (they can contain private chats); docs/ holds vetted ones only
*.png
!docs/*.png
# the status pet's artwork (original)
!app/art/pet-*/**/*.png
!app/art/pet-*/*.png
!app/renderer/pets/*/*.png

.DS_Store
Thumbs.db
!app/build/*.png

# local agent worktrees / tooling, editors, scratch and test caches
.claude/
.superpowers/
.preview/
.port/
.pytest_cache/
.vscode/
.idea/
tmp/
.tmp/

# local proof and scratch output
work/

# written by scripts/build-info.js for packaged builds
app/main/build-info.json

# make-pet-rig.py --preview sheets (last, so the !app/art/pet-* re-includes above can't bring them back)
app/art/**/_preview-*.png
